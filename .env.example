# Google OAuth client — required. Create your own Cloud project; see docs/google-setup.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Notion Internal Integration Token — optional if set during /gtd-config
# Create at: notion.so → Settings → Connections → Develop or manage integrations
NOTION_API_KEY=

# That's it. Two lines above are the only env vars you need.
#
# Telegram bot token — set inside Claude via `/telegram:configure`, NOT here.
# Notion auth — OAuth during the Telegram interview, NOT here.
# Anthropic auth — `claude login` inside the container (claude.ai OAuth), NOT here.
#
# Channel marketplace — pasted directly on the command line when you run:
#   docker compose exec -it assistant claude --channels plugin:telegram@<marketplace>
# Default marketplace is `claude-plugins-official`. If `/plugin list` shows
# something else, substitute on the command line.
