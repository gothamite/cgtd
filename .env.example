# Google OAuth client — required. Create your own Cloud project; see docs/google-setup.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Telegram channel plugin spec — used by start-channel.sh as the value of
# `claude --channels <spec>`. Format: plugin:<name>@<marketplace>, matching
# the `/plugin install <name>@<marketplace>` you ran inside Claude Code.
# Default below assumes the official Anthropic marketplace; if /plugin list
# reports a different marketplace name, replace `anthropic` with that value.
CGTD_CHANNEL_SPEC=plugin:telegram@claude-plugins-official

# Notion: no env var. Notion auth happens via OAuth during the Telegram-driven
# init interview — the user clicks a link, signs in, picks which pages to share,
# and the token is cached automatically by Claude Code.

# Anthropic auth: no env var. Channels require claude.ai login (research preview
# limitation); you'll run `claude login` once inside the container during bootstrap.
