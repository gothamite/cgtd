# Google OAuth — required. Create your own Cloud project; see docs/google-setup.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Notion integration token — required if you use Notion. See docs/notion-setup.md
NOTION_TOKEN=

# Telegram — the bot token is set inside the Telegram channel plugin via
# /telegram:configure inside Claude Code. See docs/telegram-setup.md.
# Nothing to put in this file for the bot token.

# Telegram channel plugin spec — used by start-channel.sh as the value of
# `claude --channels <spec>`. The spec format is `plugin:<name>@<marketplace>`,
# matching the `/plugin install <name>@<marketplace>` you ran inside Claude.
# Default below assumes the official Anthropic marketplace; if /plugin list
# reports a different marketplace name, replace `anthropic` with that value.
CGTD_CHANNEL_SPEC=plugin:telegram@anthropic

# Anthropic auth — DO NOT set ANTHROPIC_API_KEY for this project.
# The Telegram channel plugin requires claude.ai login (research preview limitation).
# You'll run `claude login` once inside the container; the credential persists in /data.
# See docs/architecture.md § "Authentication".
